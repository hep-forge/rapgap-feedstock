diff --git a/include/rgpiflux.inc b/include/rgpiflux.inc
new file mode 100644
index 0000000..fa73370
--- /dev/null
+++ b/include/rgpiflux.inc
@@ -0,0 +1,14 @@
+C Pion-exchange flux (IPOM = 20, 21, 22), set from the steering file:
+C   IPFF  form factor: 0 light-cone, Holtmann et al. PLB 338 (1994) 363
+C                         (default, exp(R^2 (t - m_pi^2)/(1 - x_L)), R = PIRN)
+C                      1 Regge: (1 - x_L)^(-2 alpha' t) exp(2 (t - m_pi^2)/lambda^2)
+C                         (lambda = PILM, alpha' = PIAL)
+C                      2 monopole, 3 dipole, 4 exponential (fixed scales,
+C                         Frankfurt, Mankiewicz, Strikman, Z.Phys. A 334 (1989) 343)
+C   PIRN  light-cone radius R [GeV^-1]          (default 0.93)
+C   PIGP  g^2/4pi of the pi N N coupling       (default 13.5)
+C   PILM  Regge cutoff lambda [GeV]            (default 0.65)
+C   PIAL  Regge slope alpha' [GeV^-2]          (default 1.0)
+      INTEGER IPIFF
+      DOUBLE PRECISION PIRN,PIGPP,PILAM,PIALP
+      COMMON/PIFLUX/PIRN,PIGPP,PILAM,PIALP,IPIFF
