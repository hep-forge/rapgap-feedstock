+
+      SUBROUTINE RGLAM4(IOPT,QCDL,NF)
+C Lambda_QCD for Pythia's alpha_s from the LHAPDF set in slot 1, given for NF
+C flavours: NF = 4 when the reference scale QLAM (steering 'QLAM', default
+C 3 GeV) is below the b mass PMAS(5,1), else 5.
+C   IOPT = 1: AlphaS_Lambda4 / AlphaS_Lambda5 of the set's info file; when
+C             that entry is missing (LHAPDF returns <= 0) it is computed as
+C             for IOPT = 2
+C   IOPT = 2: solved from the set's own alpha_s: Pythia's PYALPS (order
+C             MSTU(111), NF flavours) equal to alphasPDF at QLAM
+      IMPLICIT NONE
+#include "rgludat1.inc"
+#include "rgludat2.inc"
+#include "rglamqcd.inc"
+      INTEGER IOPT,NF,IT,MSTU112
+      DOUBLE PRECISION QCDL,ASPDF,ALO,AHI,AMID,PAR112
+      DOUBLE PRECISION ALPHASPDFM,PYALPS
+      EXTERNAL ALPHASPDFM,PYALPS
+      NF = 4
+      IF(QLAMQCD.GE.DBLE(PMAS(5,1))) NF = 5
+      QCDL = -1.D0
+      IF(IOPT.EQ.1) THEN
+         IF(NF.EQ.4) CALL GetLam4M(1,0,QCDL)
+         IF(NF.EQ.5) CALL GetLam5M(1,0,QCDL)
+         IF(QCDL.GT.0.D0) RETURN
+         WRITE(6,*) ' RGLAM4: no AlphaS_Lambda',NF,' in the PDF info',
+     &      ' file, computing it from the set''s alpha_s'
+      ENDIF
+      ASPDF = ALPHASPDFM(1,QLAMQCD)
+      PAR112 = PARU(112)
+      MSTU112 = MSTU(112)
+      MSTU(112) = NF
+      ALO = 0.001D0
+      AHI = 1.50D0
+      DO 10 IT = 1, 60
+         AMID = 0.5D0*(ALO+AHI)
+         PARU(112) = AMID
+         IF(PYALPS(QLAMQCD**2).GT.ASPDF) THEN
+            AHI = AMID
+         ELSE
+            ALO = AMID
+         ENDIF
+   10 CONTINUE
+      QCDL = 0.5D0*(ALO+AHI)
+      PARU(112) = PAR112
+      MSTU(112) = MSTU112
+      WRITE(6,*) ' RGLAM4: Lambda_QCD(nf=',NF,') =',QCDL,
+     &   ' from alpha_s(',QLAMQCD,' GeV) =',ASPDF,' of the PDF set,',
+     &   ' Pythia alpha_s order',MSTU(111)
+      RETURN
+      END
+
+      BLOCK DATA RGLMBD
+#include "rglamqcd.inc"
+      DATA QLAMQCD/3.D0/
+      END
